# Firebase Admin SDK - Service Account Credentials
# Get these from: Google Cloud Console > IAM & Admin > Service Accounts
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# IMPORTANT: For the private key, escape newlines as \n in Cloud Run env var
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Google Cloud Storage
GCS_BUCKET=wolfpackdna-images

# Server port (Cloud Run sets this automatically)
PORT=8080

# Email configuration (Nodemailer via SMTP)
# Use an app password for the sending account (e.g., Google Workspace app password).
# Get one at: https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=submissions@wolfpackdna.com
EMAIL_APP_PASSWORD=your-app-password-here
FROM_EMAIL=submissions@wolfpackdna.com
INTERNAL_EMAIL=admin@wolfpackdna.com

# Admin panel password (stored server-side, never in the frontend)
ADMIN_PASSWORD=your-admin-password-here
